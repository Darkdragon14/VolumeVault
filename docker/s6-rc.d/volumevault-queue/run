#!/bin/sh
set -eu

if [ "${VOLUMEVAULT_QUEUE_ENABLED:-true}" != "true" ]; then
    exec sleep infinity
fi

cd /app
# Main worker: backup/restore/group jobs. No --queue, so it follows the queue
# connection's configured default (DB_QUEUE etc.) rather than a hardcoded name —
# a custom DB_QUEUE would otherwise leave those jobs unprocessed. The archive-
# metadata listing runs on its own "metadata" queue + worker
# (volumevault-queue-metadata) so a slow listing never blocks these and starves a
# same-volume run.
exec /command/s6-setuidgid www-data php artisan queue:work --tries=1 --timeout=0
