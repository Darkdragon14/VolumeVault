#!/bin/sh
set -eu

if [ "${VOLUMEVAULT_QUEUE_ENABLED:-true}" != "true" ]; then
    exec sleep infinity
fi

cd /app
# Main worker: backup/restore/group jobs on the default queue. Archive-metadata
# listing runs on its own "metadata" queue + worker (volumevault-queue-metadata)
# so a slow destination listing never blocks these and starves a same-volume run.
exec /command/s6-setuidgid www-data php artisan queue:work --queue=default --tries=1 --timeout=0
